diff --color -ruN a/src/core/loader/development_factory.cpp b/src/core/loader/development_factory.cpp
--- a/src/core/loader/development_factory.cpp	1969-12-31 19:00:00.000000000 -0500
+++ b/src/core/loader/development_factory.cpp	2026-10-30 15:22:59.101995234 -0400
@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "core/loader/development_factory.h"
+
+#include <limits>
+#include <mutex>
+#include <stdexcept>
+#include <utility>
+#include "core/loader/loader.h"
+
+namespace Loader {
+namespace {
+struct DevelopmentRegistry {
+    std::mutex mutex;
+    DevelopmentFactory factory;
+    u64 sequence = 0;
+    u64 owner = 0;
+};
+DevelopmentRegistry& Registry() {
+    static DevelopmentRegistry registry;
+    return registry;
+}
+} // namespace
+
+u64 InstallDevelopmentFactory(DevelopmentFactory factory) {
+    auto& registry = Registry();
+    DevelopmentFactory displaced;
+    u64 token;
+    {
+        std::lock_guard lock{registry.mutex};
+        if (registry.sequence == std::numeric_limits<u64>::max())
+            throw std::overflow_error("Development factory ownership tokens exhausted");
+        token = ++registry.sequence;
+        displaced.swap(registry.factory);
+        registry.factory.swap(factory);
+        registry.owner = token;
+    }
+    // Captured objects may reenter the registry when destroyed.
+    return token;
+}
+
+bool RemoveDevelopmentFactory(u64 token) {
+    auto& registry = Registry();
+    DevelopmentFactory displaced;
+    {
+        std::lock_guard lock{registry.mutex};
+        if (token == 0 || token != registry.owner) return false;
+        displaced.swap(registry.factory);
+        registry.owner = 0;
+    }
+    return true;
+}
+
+std::unique_ptr<AppLoader> TryDevelopmentFactory(Core::System& system,
+                                                FileSys::VirtualFile file,
+                                                u64 program_id,
+                                                std::size_t program_index) {
+    if (!file) return {};
+    DevelopmentFactory factory;
+    {
+        auto& registry = Registry();
+        std::lock_guard lock{registry.mutex};
+        factory = registry.factory;
+    }
+    return factory ? factory(system, std::move(file), program_id, program_index) : nullptr;
+}
+} // namespace Loader
diff --color -ruN a/src/core/loader/development_factory.h b/src/core/loader/development_factory.h
--- a/src/core/loader/development_factory.h	1969-12-31 19:00:00.000000000 -0500
+++ b/src/core/loader/development_factory.h	2026-10-30 15:22:59.103995254 -0400
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <cstddef>
+#include <functional>
+#include <memory>
+#include "common/common_types.h"
+#include "core/file_sys/vfs/vfs_types.h"
+
+namespace Core { class System; }
+
+namespace Loader {
+class AppLoader;
+
+// An explicitly installed development hook. Returning null leaves ordinary
+// loader resolution intact. Callback exceptions propagate to the caller.
+using DevelopmentFactory = std::function<std::unique_ptr<AppLoader>(
+    Core::System&, FileSys::VirtualFile, u64 program_id, std::size_t program_index)>;
+
+// Each install replaces the previous hook and returns a nonzero ownership token.
+// Installing an empty factory clears behavior but still creates a new lease.
+u64 InstallDevelopmentFactory(DevelopmentFactory factory);
+// An old lease cannot remove a factory installed after it.
+bool RemoveDevelopmentFactory(u64 token);
+// Snapshot the callback while locked, then invoke outside the registry mutex.
+// A snapshot may finish after its lease is removed; removal is not cancellation.
+std::unique_ptr<AppLoader> TryDevelopmentFactory(Core::System& system,
+                                                FileSys::VirtualFile file,
+                                                u64 program_id,
+                                                std::size_t program_index);
+} // namespace Loader
