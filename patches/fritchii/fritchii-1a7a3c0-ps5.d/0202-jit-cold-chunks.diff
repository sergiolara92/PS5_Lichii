+std::atomic<int>& EdenJitColdOverride() {
+    static std::atomic<int> value{-1};  // -1: EDEN_JIT_COLD decides
+    return value;
+}
+
+namespace {
+// On by default (measured: lab +6.7% fps in OOT, Pro -7% CPU time on the critical cores); EDEN_JIT_COLD=0
+// turns cold chunks off. Read at the first block, after
+// the console's dev settings (env=...) are in the environment.
+bool ColdCodeEnabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("EDEN_JIT_COLD");
+        return value == nullptr || value[0] != '0';
+    }();
+    // A live override (EdenJitColdOverride, set before a JIT clear by a test driver) wins.
+    const int live = EdenJitColdOverride().load(std::memory_order_relaxed);
+    return live < 0 ? enabled : live != 0;
+}
+constexpr size_t ColdChunk = 256 * 1024;  // one reservation in the code stream
+constexpr size_t ColdSlack = 8 * 1024;    // more than any single deferred emit
+}  // namespace
+
+CodePtr BlockOfCode::BeginColdCode() {
+    const u8* const hot_end = getCurr<const u8*>();
+    // Cold code is written behind the frontier, so only through a separate writable view.
+    cold_active = ColdCodeEnabled() && prelude_complete && hasWritableAlias();
+    writing_cold = false;
+    hot_resume = hot_end;
+    ColdCodeStep();
+    return hot_end;
+}
+
+void BlockOfCode::ColdCodeStep() {
+    if (!cold_active) return;
+    if (writing_cold) cold_ptr = getCurr<const u8*>();
+    if (cold_ptr && size_t(cold_end - cold_ptr) >= ColdSlack) {
+        if (!writing_cold) SetCodePtr(cold_ptr);
+        writing_cold = true;
+        return;
+    }
+    // A new chunk at the hot frontier; hot code continues after it. Near the end of the cache
+    // the rest of this block's slow paths stay inline, as without cold code.
+    SetCodePtr(hot_resume);
+    writing_cold = false;
+    if (size_t(&top_[maxSize_] - hot_resume) < ColdChunk + 2 * 1024 * 1024) {
+        cold_active = false;
+        return;
+    }
+    EnsureMemoryCommitted(ColdChunk + 1024 * 1024);
+    cold_ptr = hot_resume;
+    cold_end = hot_resume + ColdChunk;
+    hot_resume = cold_end;
+    writing_cold = true;
+}
+
+bool BlockOfCode::EndColdCode() {
+    if (!cold_active) return false;
+    if (writing_cold) cold_ptr = getCurr<const u8*>();
+    ASSERT(cold_ptr <= cold_end);
+    SetCodePtr(hot_resume);
+    cold_active = writing_cold = false;
+    return true;
+}
+
 }  // namespace Dynarmic::Backend::X64
