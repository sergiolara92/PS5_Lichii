--- a/src/common/fiber.cpp	2026-10-30 00:29:53.059548673 -0400
+++ b/src/common/fiber.cpp	2026-10-30 00:29:53.068268486 -0400
@@ -12,6 +12,17 @@
 
 #include <boost/context/detail/fcontext.hpp>
 
+#if defined(__linux__) && !defined(__PROSPERO__)
+#include <atomic>
+#include <cstdio>
+#include <execinfo.h>
+// Research (Linux build): the JIT's run depth on this host thread (headless/dynarmic/jit_impl.inc).
+// A fiber switch with JIT code still on the stack leaves that core marked as running.
+extern "C" {
+thread_local int eden_jit_depth = 0;
+}
+#endif
+
 namespace Common {
 
 #ifdef __OPENORBIS__
@@ -87,6 +98,17 @@
 }
 
 void Fiber::YieldTo(std::weak_ptr<Fiber> weak_from, Fiber& to) {
+#if defined(__linux__) && !defined(__PROSPERO__)
+    if (eden_jit_depth > 0) {
+        static std::atomic<int> reported{};
+        if (reported++ < 3) {
+            void* frames[64];
+            const int count = backtrace(frames, 64);
+            std::fprintf(stderr, "EDEN_FIBER_SWITCH_IN_JIT depth=%d\n", eden_jit_depth);
+            backtrace_symbols_fd(frames, count, 2);
+        }
+    }
+#endif
     to.impl->guard.lock();
     to.impl->previous_fiber = weak_from.lock();
 
