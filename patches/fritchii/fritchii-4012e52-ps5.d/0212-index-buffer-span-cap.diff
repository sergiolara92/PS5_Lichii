Index buffers: the span in 64 bits, no bound from an index limit of 0, a 128 MiB cap, and an indexed draw past
it dropped (from heydemoura/EglantinePS5 core 0056: Mario Kart World race loads ran out of device memory).

diff --color -ru a/src/video_core/buffer_cache/buffer_cache.h b/src/video_core/buffer_cache/buffer_cache.h
--- a/src/video_core/buffer_cache/buffer_cache.h
+++ b/src/video_core/buffer_cache/buffer_cache.h
@@ -2431,8 +2431,25 @@
     const GPUVAddr gpu_addr_begin = index_buffer_ref.StartAddress();
     const GPUVAddr gpu_addr_end = index_buffer_ref.EndAddress();
     const std::optional<DAddr> device_addr = gpu_memory->GpuToCpuAddress(gpu_addr_begin);
-    const u32 address_size = static_cast<u32>(gpu_addr_end - gpu_addr_begin);
-    const u32 draw_size = (index_buffer_ref.count + index_buffer_ref.first) * u32(index_buffer_ref.FormatSizeInBytes());
+    // The span in 64 bits, capped at 128 MiB (64 M 16-bit indices): Switch 2 titles leave the index
+    // limit at 0 (an end below the start: no bound) and the count/first registers can hold values no
+    // draw uses. Mario Kart World's race load came here with ~1.8 billion indices; the 32-bit products
+    // wrapped to a 2.9 GB index buffer and asked the pool for 2.9 GB of staging at once (from
+    // heydemoura/EglantinePS5 core 0056). Indices past the cap read as out of bounds.
+    constexpr u64 MaxIndexBinding = u64{128} << 20;
+    const u64 address_size64 = gpu_addr_end > gpu_addr_begin ? gpu_addr_end - gpu_addr_begin : ~u64{0};
+    const u64 draw_size64 = (u64{index_buffer_ref.count} + u64{index_buffer_ref.first}) *
+                            u64{index_buffer_ref.FormatSizeInBytes()};
+    if ((std::min)(address_size64, draw_size64) > MaxIndexBinding) {
+        static std::atomic<unsigned> capped{0};
+        if (capped.fetch_add(1, std::memory_order_relaxed) < 16) {
+            LOG_WARNING(HW_GPU, "Index buffer span of {} MiB (count {}, first {}) capped at {} MiB",
+                        (std::min)(address_size64, draw_size64) >> 20, index_buffer_ref.count,
+                        index_buffer_ref.first, MaxIndexBinding >> 20);
+        }
+    }
+    const u32 address_size = static_cast<u32>((std::min)(address_size64, MaxIndexBinding));
+    const u32 draw_size = static_cast<u32>((std::min)(draw_size64, MaxIndexBinding));
     const u32 size = (std::min)(address_size, draw_size);
     if (size == 0 || !device_addr) {
         channel_state->index_buffer = NULL_BINDING;
diff --color -ru a/src/video_core/renderer_vulkan/vk_rasterizer.cpp b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
--- a/src/video_core/renderer_vulkan/vk_rasterizer.cpp
+++ b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
@@ -1062,6 +1062,21 @@
 
 void RasterizerVulkan::Draw(bool is_indexed, u32 instance_count) {
     VideoCommon::Nx2Profile::Scope profile_scope{VideoCommon::Nx2Profile::Zone::Draw};
+    // An indexed draw past the 128 MiB index binding (BufferCache::UpdateIndexBuffer) is dropped: its
+    // count register holds no real draw, and run on the GPU a 559 million index draw kept the queue
+    // busy past the driver's 10 s limit (device lost; heydemoura/EglantinePS5 core 0056).
+    if (is_indexed) {
+        const auto& index_buffer = maxwell3d->draw_manager.draw_state.index_buffer;
+        if ((u64{index_buffer.count} + u64{index_buffer.first}) * u64{index_buffer.FormatSizeInBytes()} >
+            (u64{128} << 20)) {
+            static std::atomic<unsigned> dropped{0};
+            if (dropped.fetch_add(1, std::memory_order_relaxed) < 16) {
+                LOG_WARNING(Render_Vulkan, "Indexed draw of {} indices (first {}) dropped: past the index binding",
+                            index_buffer.count, index_buffer.first);
+            }
+            return;
+        }
+    }
     // A vertex count GPU work wrote (nx2_indirect_grid.h): drawn with that count, read on the GPU.
     // Draws that need the count here (the indirect reset, quads, a first vertex) read the words,
     // which waits for the GPU on this thread.
