RADV keeps its own pipeline cache (zortos293/Lichii#1103, port of Eglantine #714): no
vulkan_pipelines.bin held in the shared heap and rewritten during boots. The precompiled
preparation, which the same check gates, is left as it was.

--- a/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
+++ b/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
@@ -600,6 +600,23 @@
         return false;
     }
 }
+
+// RADV keeps built pipelines in Mesa's disk cache unless it is turned off (zortos293/Lichii#1103,
+// from Eglantine #714), so Eden keeps no VkPipelineCache on top there either: on the PS5 it was
+// loaded whole into the heap the guest shares, and copied out and written again every ~33 s
+// while a boot built pipelines. Only the cache file goes: the precompiled preparation stays off.
+bool MesaCachesPipelines(const Device& device) {
+    if (device.GetDriverID() != VK_DRIVER_ID_MESA_RADV) {
+        return false;
+    }
+    for (const char* name : {"MESA_SHADER_CACHE_DISABLE", "MESA_GLSL_CACHE_DISABLE"}) {
+        const char* value = std::getenv(name);
+        if (value != nullptr && (std::string_view{value} == "1" || std::string_view{value} == "true")) {
+            return false;
+        }
+    }
+    return true;
+}
 } // Anonymous namespace
 
