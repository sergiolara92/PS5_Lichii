     /// Copies the list's deferred entries (CommandList::deferred_entries) from memory.
     void RefreshDeferredEntries(CommandList& list);
 
+    /// Trust copy (GrowingBlackBeans, viejunerd/Eglantine-PS5-#21): a list copied while the
+    /// channel ran keeps that copy across later suspensions, and an entry resumed after an
+    /// acquire parses the rest of it from the copy. Ocarina of Time runs a frame ahead and
+    /// rewrites the same command ring for the next frame, so words read again after the acquire
+    /// were the next frame's (methods on unbound subchannels, then std::bad_alloc on GPUBack).
+    /// A list copied during a suspension is still read again (the game writes it before the
+    /// release: Hyrule Warriors), as are GPU-written entries.
+    bool KeepsCopy(const CommandList& list) const {
+        return trust_copy && (list.snapshot_suspensions & 1) == 0;
+    }
