+// Out of device memory (a course load filling memory the CPU and GPU share): give back every
+// staging buffer the GPU is done with and try again, then once more after waiting for the GPU, so
+// the ones still in flight are done too. Unhandled, the error ended the app.
+vk::Buffer StagingBufferPool::CreateBufferOrRecover(const VkBufferCreateInfo& buffer_ci, MemoryUsage usage) {
+    for (int attempt = 0;; ++attempt) {
+        try {
+            return memory_allocator.CreateBuffer(buffer_ci, usage);
+        } catch (const vk::Exception& exception) {
+            if (attempt == 2 || (exception.GetResult() != VK_ERROR_OUT_OF_DEVICE_MEMORY &&
+                                 exception.GetResult() != VK_ERROR_OUT_OF_HOST_MEMORY)) {
+                throw;
+            }
+            LOG_WARNING(Render_Vulkan, "Staging buffer of {} bytes: out of memory, freeing idle staging buffers{}",
+                        buffer_ci.size, attempt == 1 ? " after waiting for the GPU" : "");
+            if (attempt == 1) {
+                scheduler.Finish();
+            }
+            ReleaseIdle();
+        }
+    }
+}
+
+// Every staging buffer the GPU is done with goes back to the driver (out of device memory: here and
+// the allocator's recovery, through the texture cache runtime).
+void StagingBufferPool::ReleaseIdle() {
+    for (auto* cache : {&device_local_cache, &upload_cache, &download_cache}) {
+        for (auto& level : *cache) {
+            std::erase_if(level.entries, [this](const StagingBuffer& entry) {
+                return !entry.deferred && scheduler.IsFree(entry.tick);
+            });
+            level.delete_index = 0;
+            level.iterate_index = 0;
+        }
+    }
+}
