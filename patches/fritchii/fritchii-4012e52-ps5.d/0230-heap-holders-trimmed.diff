+TEST_CASE("ObjectPool::ReleaseContents keeps a bounded chunk and stays usable", "[shader]") {
+    struct Big {
+        explicit Big(int value_) : value{value_} {}
+        int value;
+        char pad[1 << 20];
+    };
+    Shader::ObjectPool<Big> pool{2};
+    // 16 MiB of objects, over the 4 MiB the pool may keep
+    for (int round = 0; round < 3; ++round) {
+        Big* first{};
+        for (int index = 0; index < 16; ++index) {
+            Big* const object{pool.Create(index)};
+            first = first ? first : object;
+            REQUIRE(object->value == index);
+        }
+        REQUIRE(first->value == 0);
+        pool.ReleaseContents();
+    }
+}
