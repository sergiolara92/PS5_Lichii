Skip direct draws known to produce no work before pipeline, buffer and descriptor setup.
The upstream Bananza profile counted 250-400 such calls per frame; this generic Vulkan
path applies to any title that emits zero-vertex or zero-instance direct draws.

--- a/src/video_core/renderer_vulkan/vk_rasterizer.cpp
+++ b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
@@ -1273,3 +1273,19 @@ void RasterizerVulkan::Draw(bool is_indexed, u32 instance_count) {
         }
     }
+    // No command is recorded for these direct draws. Keep pending state for the next draw,
+    // clear or render-pass end, which applies it before it can be observed.
+    if (!gpu_count && maxwell3d->regs.transform_feedback_enabled == 0 &&
+        (MakeDrawParams(maxwell3d->draw_manager.draw_state, instance_count, is_indexed)
+                 .num_vertices == 0 ||
+         (instance_count == 0 && [this] {
+             const GraphicsPipeline* const pipeline = pipeline_cache.CurrentGraphicsPipeline();
+             return pipeline != nullptr && !pipeline->IsMeshPipeline();
+         }()))) {
+        if (Common::DkbFrameTrace::Enabled()) {
+            ++trace_draws;
+            ++trace_zero_direct;
+        }
+        gpu.TickWork();
+        return;
+    }
     PrepareDraw(is_indexed, [this, is_indexed, instance_count, gpu_count] {
