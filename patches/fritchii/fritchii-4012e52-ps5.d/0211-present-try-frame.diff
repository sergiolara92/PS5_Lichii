+Frame* PresentManager::TryGetRenderFrame(size_t keep) {
+    Frame* frame = nullptr;
+    {
+        std::scoped_lock lock{free_mutex};
+        if (free_queue.size() <= keep) {
+            return nullptr;
+        }
+        frame = free_queue.front();
+        free_queue.pop_front();
+    }
+    // A frame in the free queue has been handed to the display; its resources free once that ends.
+    frame->present_done.Wait();
+    frame->present_done.Reset();
+    return frame;
+}
