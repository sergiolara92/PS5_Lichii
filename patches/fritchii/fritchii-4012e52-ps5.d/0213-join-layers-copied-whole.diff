Texture joins: skip the upload when the GPU-written overlaps' copies together overwrite every level and layer
(zortos293/Lichii#1079, for Fritchii's own overwritten_by_copies; MKW array uploads took 13-59 ms).

diff --color -ru a/src/video_core/texture_cache/texture_cache.h b/src/video_core/texture_cache/texture_cache.h
--- a/src/video_core/texture_cache/texture_cache.h
+++ b/src/video_core/texture_cache/texture_cache.h
@@ -3781,6 +3781,33 @@
         constexpr ImageFlagBits unusual = ImageFlagBits::Sparse | ImageFlagBits::SparseLayers |
                                           ImageFlagBits::SparseTiles |
                                           ImageFlagBits::UnwrittenSparse | ImageFlagBits::Unbacked;
+        // Arrays and mip chains (zortos293/Lichii#1079): the copies from overlaps the GPU wrote can
+        // each write a part of it, together all of it. Mario Kart World renders each layer of its
+        // shadow map (3072x3072x3) and colour arrays as a target of its own, then samples the array:
+        // the upload under those copies took 13-59 ms an array. Only at 1x: a rescaled copy's extent
+        // is the scaled guest mip size, which can fall short of the host mip.
+        if (image_info.type == ImageType::e2D && image_info.num_samples == 1 && !can_rescale &&
+            (image_info.resources.levels > 1 || image_info.resources.layers > 1) &&
+            False(new_image.flags & (unusual | ImageFlagBits::Converted |
+                                     ImageFlagBits::AsynchronousDecode))) {
+            std::vector<u8> written(
+                static_cast<size_t>(image_info.resources.levels * image_info.resources.layers));
+            for (const JoinCopy& copy : join_copies_to_do) {
+                const ImageBase& overlap = slot_images[copy.id];
+                if (copy.is_alias || False(overlap.flags & ImageFlagBits::GpuModified) ||
+                    overlap.info.num_samples != 1) {
+                    continue;
+                }
+                const std::optional<SubresourceBase> base = new_image.TryFindBase(overlap.gpu_addr);
+                if (!base) {
+                    continue;
+                }
+                MarkSubresourcesWrittenWhole(new_image, overlap,
+                                             MakeShrinkImageCopies(image_info, overlap.info, *base, 1, 0),
+                                             written);
+            }
+            return std::ranges::all_of(written, [](u8 whole) { return whole != 0; });
+        }
