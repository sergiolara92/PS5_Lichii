         const auto entered = std::chrono::steady_clock::now();
+        if (eden_nx2_present_hook && m_stats.last_present != std::chrono::steady_clock::time_point{}) {
+            eden_nx2_present_hook(
+                std::chrono::duration_cast<std::chrono::microseconds>(entered - m_stats.last_present).count(),
+                m_last_blocked_us);
+        }
         if (frames_ahead == 1 || (frames_ahead == -1 && !WaitForFrame(~w[22], w[24], true))) {
             LOG_DEBUG(Service, "nx2:vi2 present #{} fence ({}, {:#x}), waiting for ({}, {:#x}); now {:#x}",
                       m_presents, ~w[22], w[24], m_previous_fence_id, m_previous_fence_value,
@@ -1816,6 +1826,7 @@
         const auto composited = std::chrono::steady_clock::now();
         PaceToVblank(w[12], ctx.GetThread().GetOwnerProcess());
         const auto paced = std::chrono::steady_clock::now();
