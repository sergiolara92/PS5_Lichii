nx2:vi2 present: each present calls eden_nx2_present_hook (weak) with the time since the previous present
and how long that one was blocked in the present path, so the PS5 development build says what happened
during each long frame (headless/performance.cpp, EDEN_HITCH). Eglantine patch 0043, re-anchored for Fritchii.

--- a/src/core/hle/service/nx2_gsv.h
+++ b/src/core/hle/service/nx2_gsv.h
@@ -81,6 +81,11 @@
 #include "core/hle/service/server_manager.h"
 #include "core/hle/service/service.h"
 
+// Called at each present with the time since the previous one and how long that previous present
+// was blocked here (fence, composite, pacing), both in us; the PS5 build's development reports
+// define it (headless/performance.cpp, EDEN_HITCH lines) and other builds leave it null.
+extern "C" void eden_nx2_present_hook(long long frame_us, long long blocked_us) __attribute__((weak));
+
 namespace Service {
 
 // Creates a session served by `iface` and returns its client end. Unlike PushIpcInterface this
@@ -1788,6 +1793,11 @@
             frames_ahead = 1;
