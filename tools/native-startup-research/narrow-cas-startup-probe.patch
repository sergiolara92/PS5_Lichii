+std::optional<u16> DynarmicCallbacks64::MemoryAtomicCompareExchange16(
+    u64 address, u16 expected, u16 desired, Dynarmic::ExclusiveMonitor* monitor) {
+    auto reject = [&](const char* reason) -> std::optional<u16> {
+        LOG_CRITICAL(Core_ARM, "CAS16 rejected address={:#x}, reason={}", address, reason);
+#ifdef PROSPERO_CPU_TRACE
+        std::fprintf(stderr, "CPU_TRACE cas16_rejected address=%016llx reason=%s action=memory_abort_no_writeback\n",
+                     static_cast<unsigned long long>(address), reason);
+        std::fflush(stderr);
+#endif
+        return std::nullopt;
+    };
+    if ((address & 1) != 0) return reject("alignment");
+    if (address > std::numeric_limits<u64>::max() - sizeof(u16) ||
+        !m_memory.IsValidVirtualAddressRange(address, sizeof(u16))) return reject("span_or_unmapped");
+    if (!monitor) return reject("monitor");
+    if (!CheckMemoryAccess(address, sizeof(u16), Kernel::DebugWatchpointType::Read) ||
+        !CheckMemoryAccess(address, sizeof(u16), Kernel::DebugWatchpointType::Write))
+        return reject("watchpoint_or_memory_access");
+    // GPU/cache preparation may block, so it happens before page/monitor locks.
+    u16* pointer = m_memory.PrepareAtomicPointer16(address);
+    if (!pointer) return reject("coherence_pointer");
+    u16 observed = 0;
+    const char* rejection = "mapping";
+    const bool performed = m_process->GetPageTable().GetBasePageTable().WithAtomicAccess16(
+        address, pointer, rejection, [&]() {
+            monitor->DoAtomicOperation([&]() {
+                // One genuine typed 16-bit host seq_cst CAS; no wider overlapping atomic.
+                // Exactly one atomic returns the old value on both match/failure.
+                (void)Common::AtomicCompareAndSwap(pointer, desired, expected, observed);
+            });
+        });
+    // Kernel page lock and monitor are both released before diagnostics.
+    if (!performed) return reject(rejection);
+    return observed;
+}
