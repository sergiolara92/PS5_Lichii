+    // The kernel already stores virtual affinity and translates virtual IDs via
+    // VirtualToPhysicalCoreMap. The verified research process requests core5.
+    // Expose this existing virtual scheduler model, not extra physical CPUs.
+    // Ordinary applications keep the original four-core validation.
+    const bool research_virtual = process.GetProgramId() == 0x0400c3f00006e000ULL &&
+                                  process.GetPageTable().HasResearchRemoteRegion();
+    const auto count = research_virtual ? Core::Hardware::NumVirtualCores
+                                       : Core::Hardware::NUM_CPU_CORES;
+    return core_id >= 0 && static_cast<size_t>(core_id) < count;
 }
 
