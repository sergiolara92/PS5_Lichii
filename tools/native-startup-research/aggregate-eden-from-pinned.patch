+    const u64 mask = (u64{1} << bits) - 1;
+    // Bit 55 selects the address extension; this is NOT a sign extend of bit VA-1.
+    const auto extension = ir.ArithmeticShiftRight(
+        ir.LogicalShiftLeft(pointer, ir.Imm8(8)), ir.Imm8(63));
+    X(64, Rd, ir.Or(ir.And(pointer, ir.Imm64(mask)),
+                   ir.And(extension, ir.Imm64(~mask))));
     return true;
 }
 
