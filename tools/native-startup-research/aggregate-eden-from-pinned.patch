+std::optional<u32> DynarmicCallbacks64::MemoryAtomicCompareExchange32(
+    u64 address, u32 expected, u32 desired, Dynarmic::ExclusiveMonitor* monitor) {
+    auto reject = [&](const char* reason) -> std::optional<u32> {
+        LOG_CRITICAL(Core_ARM, "CASA32 rejected address={:#x}, reason={}", address, reason);
+#ifdef PROSPERO_CPU_TRACE
+        std::fprintf(stderr, "CPU_TRACE casa32_rejected address=%016llx reason=%s action=memory_abort_no_writeback\n",
+                     static_cast<unsigned long long>(address), reason);
+        std::fflush(stderr);
+#endif
+        return std::nullopt;
+    };
+    if ((address & 3) != 0) return reject("alignment");
+    if (address > std::numeric_limits<u64>::max() - sizeof(u32) ||
+        !m_memory.IsValidVirtualAddressRange(address, sizeof(u32))) return reject("span_or_unmapped");
+    if (!monitor) return reject("monitor");
+    if (!CheckMemoryAccess(address, sizeof(u32), Kernel::DebugWatchpointType::Read) ||
+        !CheckMemoryAccess(address, sizeof(u32), Kernel::DebugWatchpointType::Write))
+        return reject("watchpoint_or_memory_access");
+    // GPU/cache preparation may block, so it happens before page/monitor locks.
+    u32* pointer = m_memory.PrepareAtomicPointer32(address);
+    if (!pointer) return reject("coherence_pointer");
+    u32 observed = 0;
+    const char* rejection = "mapping";
+    const bool performed = m_process->GetPageTable().GetBasePageTable().WithAtomicAccess32(
+        address, pointer, rejection, [&]() {
+            monitor->DoAtomicOperation([&]() {
+                // Full host seq_cst barrier is stronger than acquire-only CASA.
+                // Exactly one atomic returns the old value on both match/failure.
+                (void)Common::AtomicCompareAndSwap(pointer, desired, expected, observed);
+            });
+        });
+    // Kernel page lock and monitor are both released before diagnostics.
+    if (!performed) return reject(rejection);
+    return observed;
+}
